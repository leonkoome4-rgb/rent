DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renttrack"
JWT_SECRET="change-me"          # use 32+ random chars: openssl rand -hex 32
PORT=5001

MPESA_ENV="mock"                 # mock | sandbox | live
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"         # sandbox test shortcode
MPESA_PASSKEY=""                 # sandbox passkey
MPESA_CALLBACK_URL="http://localhost:5001/api/mpesa/stk-callback"   # placeholder, not reachable yet
MPESA_CALLBACK_SECRET=""         # optional: register Daraja URLs with ?secret=<this>

APP_URL="http://localhost:5173"  # used in SMS/WhatsApp invite links and CORS
CORS_ORIGINS=""                  # extra comma-separated origins allowed to call the API
SMS_DRIVER="mock"                # mock = messages only appear in the in-app Outbox
CRON_SECRET=""                   # Vercel Cron sends this as a Bearer token to /api/cron/daily
